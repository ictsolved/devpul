---
// The UI's ThemeToggle: one button through Auto, Light and Dark with lucide's icons.
const attrs = {
  xmlns: 'http://www.w3.org/2000/svg',
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': 2,
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
  'aria-hidden': 'true',
} as const;
---

<devpul-theme-toggle>
  <button type="button" aria-label="Theme: Auto" title="Theme: Auto">
    <svg class="system" {...attrs}>
      <rect width="20" height="14" x="2" y="3" rx="2"></rect>
      <line x1="8" x2="16" y1="21" y2="21"></line>
      <line x1="12" x2="12" y1="17" y2="21"></line>
    </svg>
    <svg class="light" {...attrs}>
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2"></path>
      <path d="M12 20v2"></path>
      <path d="m4.93 4.93 1.41 1.41"></path>
      <path d="m17.66 17.66 1.41 1.41"></path>
      <path d="M2 12h2"></path>
      <path d="M20 12h2"></path>
      <path d="m6.34 17.66-1.41 1.41"></path>
      <path d="m19.07 4.93-1.41 1.41"></path>
    </svg>
    <svg class="dark" {...attrs}>
      <path
        d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"
      ></path>
    </svg>
  </button>
</devpul-theme-toggle>

<script>
  type Choice = 'system' | 'light' | 'dark';
  const NEXT: Record<Choice, Choice> = { system: 'light', light: 'dark', dark: 'system' };
  const NAME: Record<Choice, string> = { system: 'Auto', light: 'Light', dark: 'Dark' };
  const root = document.documentElement;
  const light = matchMedia('(prefers-color-scheme: light)');

  const current = (): Choice => {
    const choice = root.dataset.themeChoice;
    return choice === 'light' || choice === 'dark' ? choice : 'system';
  };

  function apply(choice: Choice) {
    root.dataset.themeChoice = choice;
    root.dataset.theme = choice === 'system' ? (light.matches ? 'light' : 'dark') : choice;
    for (const button of document.querySelectorAll('devpul-theme-toggle button')) {
      button.setAttribute('aria-label', `Theme: ${NAME[choice]}`);
      button.setAttribute('title', `Theme: ${NAME[choice]}`);
    }
  }

  light.addEventListener('change', () => {
    if (current() === 'system') apply('system');
  });

  customElements.define(
    'devpul-theme-toggle',
    class extends HTMLElement {
      connectedCallback() {
        this.querySelector('button')?.addEventListener('click', () => {
          const next = NEXT[current()];
          try {
            localStorage.setItem('devpul:theme', JSON.stringify(next));
            localStorage.setItem('starlight-theme', next === 'system' ? '' : next);
          } catch {}
          apply(next);
        });
      }
    },
  );
  apply(current());
</script>

<style>
  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: 1px solid var(--input);
    border-radius: calc(var(--radius) - 2px);
    background: var(--background);
    color: var(--sl-color-text);
    cursor: pointer;
  }
  button:hover {
    background: var(--accent);
    color: var(--sl-color-white);
  }
  button:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  svg {
    width: 0.875rem;
    height: 0.875rem;
  }
  .light,
  .dark,
  :global(:root[data-theme-choice='light']) .system,
  :global(:root[data-theme-choice='dark']) .system {
    display: none;
  }
  :global(:root[data-theme-choice='light']) .light,
  :global(:root[data-theme-choice='dark']) .dark {
    display: block;
  }
</style>
