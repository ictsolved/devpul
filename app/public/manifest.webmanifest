{
  "name": "DevPul",
  "short_name": "DevPul",
  "description": "Inspect Dart and Flutter HTTP calls, errors and events in the browser.",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#0b1416",
  "theme_color": "#0f766e",
  "icons": [
    { "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" }
  ]
}
