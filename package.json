{
  "name": "devpul-monorepo",
  "private": true,
  "workspaces": [
    "apps/ui"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/ui",
    "build": "npm run build -w apps/ui",
    "check": "npm run check:dart && npm run check:web",
    "check:dart": "tool/check_dart.sh",
    "check:web": "prettier --check . && npm run check -w apps/ui",
    "format": "prettier --write .",
    "deploy": "npm run build:registry && npm run deploy -w apps/ui",
    "build:registry": "dart run tool/build_registry.dart build/registry",
    "build:extension": "node tool/build_extension.mjs"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
