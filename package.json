{
  "name": "devpul-monorepo",
  "private": true,
  "workspaces": [
    "apps/ui",
    "apps/docs"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/ui",
    "build": "npm run build -w apps/ui",
    "check": "npm run check:dart && npm run check:web",
    "check:dart": "tool/check_dart.sh",
    "check:web": "prettier --check . && npm run check -w apps/ui && npm run check -w apps/docs",
    "check:release": "dart run tool/release_check.dart",
    "format": "prettier --write .",
    "build:registry": "dart run tool/build_registry.dart build/registry",
    "build:site": "node tool/build-site.mjs",
    "build:pages": "tool/build_pages.sh",
    "build:extension": "node tool/build_extension.mjs",
    "screenshots": "npm run screenshots -w apps/ui"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
